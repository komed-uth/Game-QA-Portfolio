{
  "name": "game-qa-portfolio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "sync:reports": "node scripts/sync-reports.mjs",
    "predev": "npm run sync:reports",
    "prestart": "npm run sync:reports",
    "prebuild": "npm run sync:reports",
    "dev": "vite",
    "start": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "check:browser": "node scripts/check-browser.mjs",
    "check:reports": "node scripts/check-browser.mjs --reports-only",
    "check:overlays": "node --test scripts/browser/report-overlay-data.test.mjs && node scripts/check-report-overlays.mjs",
    "check:preview": "node --test scripts/browser/preview-server.test.mjs scripts/browser/report-overlay-data.test.mjs scripts/browser/check-selection.test.mjs",
    "check:gameplay": "node scripts/check-browser.mjs --gameplay-only",
    "check:photos": "node scripts/check-browser.mjs --photos-only",
    "check:evidence": "node scripts/check-browser.mjs --evidence-only",
    "precheck:runner": "npm run check:sandcastle",
    "check:runner": "node --test scripts/browser/check-selection.test.mjs scripts/browser/stable-inputs.test.mjs scripts/browser/run-browser-check.test.mjs",
    "sandcastle": "tsx .sandcastle/main.ts",
    "sandcastle:doctor": "tsx .sandcastle/main.ts --doctor",
    "sandcastle:smoke": "tsx .sandcastle/main.ts --smoke",
    "sandcastle:build-image": "tsx .sandcastle/main.ts --build-image",
    "check:sandcastle": "tsc -p .sandcastle/tsconfig.json && node --import tsx --test .sandcastle/policy.test.ts"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^5.0.0",
    "playwright": "1.62.1",
    "typescript": "^5.9.2",
    "vite": "^7.0.0",
    "@ai-hero/sandcastle": "0.12.0",
    "@types/node": "22.20.5",
    "tsx": "4.23.15"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
