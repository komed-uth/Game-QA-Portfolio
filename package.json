{
  "name": "game-qa-portfolio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "sync:reports": "node scripts/sync-reports.mjs",
    "predev": "npm run check:project-dependencies && npm run sync:reports && npm run validate:content",
    "prestart": "npm run check:project-dependencies && npm run sync:reports && npm run validate:content",
    "prebuild": "npm run check:project-dependencies && npm run sync:reports",
    "dev": "vite",
    "start": "vite",
    "build": "npm run validate:content && tsc --noEmit && vite build",
    "validate:content": "node scripts/validate-content.mjs",
    "check:content": "node --test scripts/content-validation.test.mjs scripts/layout-content.test.mjs",
    "check:content-workflow": "node scripts/check-content-workflow.mjs",
    "preview": "vite preview",
    "check:browser": "node scripts/check-browser.mjs",
    "check:reports": "node scripts/check-browser.mjs --reports-only",
    "check:report-layout": "node scripts/check-browser.mjs --report-layout-only",
    "check:workstation": "node scripts/check-workstation.mjs",
    "check:whitespace": "node scripts/check-diff-whitespace.mjs",
    "check:overlays": "node --test scripts/browser/report-overlay-data.test.mjs && node scripts/check-report-overlays.mjs",
    "check:preview": "node --test scripts/browser/preview-server.test.mjs scripts/browser/report-overlay-data.test.mjs scripts/browser/check-selection.test.mjs scripts/content-validation.test.mjs scripts/layout-content.test.mjs",
    "check:gameplay": "node scripts/check-browser.mjs --gameplay-only",
    "check:slideshow": "node scripts/check-browser.mjs --slideshow-only",
    "check:placeholders": "node scripts/check-browser.mjs --placeholders-only",
    "check:photos": "node scripts/check-browser.mjs --photos-only",
    "check:evidence": "node scripts/check-browser.mjs --evidence-only",
    "check:runner": "node --test scripts/browser/check-selection.test.mjs scripts/browser/stable-inputs.test.mjs scripts/browser/run-browser-check.test.mjs scripts/browser/capture-region.test.mjs scripts/check-workstation.test.mjs scripts/check-project-dependencies.test.mjs scripts/check-merge-readiness.test.mjs scripts/check-diff-whitespace.test.mjs scripts/browser/recorded-run.test.mjs scripts/sync-reports.test.mjs",
    "prepreview": "npm run check:project-dependencies",
    "precheck:browser": "npm run check:project-dependencies",
    "precheck:preview": "npm run check:project-dependencies",
    "precheck:runner": "npm run check:project-dependencies",
    "check:project-dependencies": "node scripts/check-project-dependencies.mjs",
    "check:merge-readiness": "node scripts/check-merge-readiness.mjs",
    "precheck:reports": "npm run check:project-dependencies",
    "precheck:report-layout": "npm run check:project-dependencies",
    "precheck:gameplay": "npm run check:project-dependencies",
    "precheck:slideshow": "npm run check:project-dependencies",
    "precheck:placeholders": "npm run check:project-dependencies",
    "precheck:photos": "npm run check:project-dependencies",
    "precheck:evidence": "npm run check:project-dependencies"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^5.0.0",
    "playwright": "1.62.1",
    "typescript": "^5.9.2",
    "vite": "^7.0.0"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
